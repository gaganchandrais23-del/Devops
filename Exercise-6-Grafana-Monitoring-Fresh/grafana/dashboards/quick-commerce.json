{
  "uid": "quick-commerce",
  "title": "Quick Commerce Real-Time Monitoring",
  "tags": ["quick-commerce", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Completed Deliveries",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus-fresh"},
      "targets": [
        {
          "expr": "quickcommerce_deliveries_total",
          "legendFormat": "Completed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Orders",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus-fresh"},
      "targets": [
        {
          "expr": "quickcommerce_active_orders",
          "legendFormat": "Active orders",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Delivery Time (Seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus-fresh"},
      "targets": [
        {
          "expr": "quickcommerce_delivery_time_seconds",
          "legendFormat": "Delivery time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Failed Deliveries",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus-fresh"},
      "targets": [
        {
          "expr": "quickcommerce_failed_deliveries_total",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ]
    }
  ]
}
